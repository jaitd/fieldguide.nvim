#!/usr/bin/env -S nvim -l
-- The client. One `nvim -l` script; dumb transport.
--
--   fieldguide state --what=buffers,diagnostics
--   fieldguide docs --query=fugitive --fetch
--   fieldguide explain_keymap --lhs='<leader>gs'
--   fieldguide verify
--   fieldguide --json '{"verb":"docs","args":{"query":"lazy.nvim"}}'
--
-- Prints one JSON object to stdout. Keeping this a standalone CLI rather than
-- folding it into the pi extension is the seam that makes the harness an
-- adapter rather than the architecture: an MCP mode is ~80 lines on top, and
-- every future consumer shares one dispatch path.
--
-- `nvim -l` + sockconnect rather than `nvim --server --remote-expr` on purpose:
-- with NVIM_APPNAME set, `--server` writes a warning to *stdout* and corrupts
-- parsed output.

local function die(msg)
  io.stderr:write("fieldguide: " .. msg .. "\n")
  os.exit(1)
end

local function emit(obj)
  io.write(vim.json.encode(obj))
  io.write("\n")
end

local argv = _G.arg or {}
local verb, args, raw_json = nil, {}, nil

local i = 1
while i <= #argv do
  local a = argv[i]
  if a == "--json" then
    i = i + 1
    raw_json = argv[i]
  elseif a == "--help" or a == "-h" then
    io.write("usage: fieldguide <verb> [--key=value ...] | fieldguide --json '<payload>'\n")
    io.write("verbs: state docs explain_keymap verify reload checkpoint\n")
    os.exit(0)
  elseif a:sub(1, 2) == "--" then
    local key, value = a:sub(3):match("^([^=]+)=?(.*)$")
    if value == "" then
      args[key] = true
    elseif tonumber(value) then
      args[key] = tonumber(value)
    elseif value == "true" or value == "false" then
      args[key] = value == "true"
    else
      args[key] = value
    end
  elseif not verb then
    verb = a
  else
    die("unexpected argument: " .. a)
  end
  i = i + 1
end

if raw_json then
  local ok, payload = pcall(vim.json.decode, raw_json)
  if not ok or type(payload) ~= "table" then
    die("--json payload is not a JSON object")
  end
  verb = payload.verb or verb
  args = payload.args or args
end

if not verb then
  die("no verb given (try --help)")
end

-- Handed to us explicitly by the sidebar so that a future loosening of the tool
-- list cannot silently re-expose the socket through $NVIM.
local addr = os.getenv("FIELDGUIDE_ADDR")
if not addr or addr == "" then
  addr = os.getenv("NVIM")
end
if not addr or addr == "" then
  die("no Neovim socket: set FIELDGUIDE_ADDR, or run this from a terminal inside Neovim")
end

local ok, chan = pcall(vim.fn.sockconnect, "pipe", addr, { rpc = true })
if not ok or chan == 0 then
  -- Agents recover well from clear errors and badly from empty output.
  die(("cannot connect to Neovim at %s — the editor it belonged to is gone"):format(addr))
end

---One RPC round trip to the editor. Dies (clear stderr message, exit 1) on a
---transport failure or a malformed reply — the same handling every verb had
---before `verify` grew a CLI-side half.
---@param v string
---@param a table
---@return table
local function call_verb(v, a)
  local sent, res = pcall(
    vim.rpcrequest,
    chan,
    "nvim_exec_lua",
    "local verb, args = ... ; return require('fieldguide.api').call(verb, args)",
    { v, a }
  )
  if not sent then
    die(("rpc failed: %s"):format(tostring(res)))
  end
  -- The contract with the extension is one JSON object on stdout. A verb that
  -- returned nothing would make vim.json.encode throw a traceback instead, and
  -- the extension would report "no output" rather than which verb misbehaved.
  if type(res) ~= "table" then
    die(("verb %s returned %s, not a table"):format(v, type(res)))
  end
  return res
end

-- `verify` boots a whole sandboxed headless Neovim, which can take the full
-- verify.timeout_ms. Run that child here, in the CLI's own process, instead
-- of inside the editor's RPC handler — the editor plans and interprets, but
-- never blocks on the boot itself.
if verb == "verify" then
  local plan_env = call_verb("verify_plan", args)
  if plan_env.ok == false then
    emit(plan_env)
    os.exit(2)
  end

  local plan = plan_env.result
  if type(plan) ~= "table" or plan.ok == false then
    -- The plan itself failed (no sandbox backend, etc.) — same shape a
    -- failed `verify` has always returned; nothing was spawned.
    emit(plan_env)
    os.exit(0)
  end

  local t0 = vim.uv.hrtime()
  local ok_spawn, proc = pcall(vim.system, plan.argv, {
    cwd = plan.cwd,
    env = plan.env,
    clear_env = true,
    text = true,
  })
  if not ok_spawn then
    for _, path in ipairs(plan.temp or {}) do
      vim.fn.delete(path, "rf")
    end
    emit({ ok = true, result = { ok = false, error = "failed to spawn sandbox: " .. tostring(proc) } })
    os.exit(0)
  end

  local proc_res = proc:wait(plan.timeout_ms)
  local duration_ms = math.floor((vim.uv.hrtime() - t0) / 1e4) / 100
  for _, path in ipairs(plan.temp or {}) do
    vim.fn.delete(path, "rf")
  end

  local interp_env = call_verb("verify_interpret", {
    res = { code = proc_res.code, signal = proc_res.signal, stdout = proc_res.stdout, stderr = proc_res.stderr },
    duration_ms = duration_ms,
    timeout_ms = plan.timeout_ms,
    sandbox = plan.sandbox,
  })
  emit(interp_env)
  os.exit(interp_env.ok == false and 2 or 0)
end

local res = call_verb(verb, args)
emit(res)
if res.ok == false then
  os.exit(2)
end
